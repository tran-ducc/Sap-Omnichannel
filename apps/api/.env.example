DATABASE_URL="postgresql://omni:omni_dev_password@127.0.0.1:5432/omni_retail?schema=public"
# Same as DATABASE_URL locally. On Supabase: DATABASE_URL = pooled URL (:6543, add ?pgbouncer=true&connection_limit=1),
# DIRECT_URL = direct/session URL (:5432), used by `prisma migrate`.
DIRECT_URL="postgresql://omni:omni_dev_password@127.0.0.1:5432/omni_retail?schema=public"
# Set to "none" when web and API are on different sites (e.g. two *.up.railway.app / *.onrender.com domains).
COOKIE_SAME_SITE="lax"
REDIS_URL="redis://127.0.0.1:6379"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30
CREDENTIALS_ENCRYPTION_KEY="32-byte-hex-key-for-channel-credentials"
PORT=4000
WEB_ORIGIN="http://localhost:3000"
